<launch>
    <param name="robot_description" textfile="$(find my_drone_description)/urdf/simple_drone.urdf" />

    <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher" />

    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" />

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find my_drone_description)/rviz/urdf.rviz" />
</launch>